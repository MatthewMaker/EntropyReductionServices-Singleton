#!/bin/sh
# Refuses a commit whose generated files have drifted from their sources: the analyzer rulesets
# from .editorconfig, and Version.props and the release notes from package.json. Also refuses one
# where the two LICENSE copies differ.
#
# Enable once per clone — git does not version .git/hooks, so this directory has to be pointed at:
#
#     git config core.hooksPath .githooks
#
# CI runs the same check, so a clone that never enables the hook is still caught; the hook only
# moves the failure earlier. Bypass with --no-verify if you genuinely need to.

if ! python3 scripts/sync-analyzer-severities.py --check; then
    echo
    echo "pre-commit: analyzer severities are out of sync. Regenerate, stage, and commit again."
    exit 1
fi

if ! python3 scripts/sync-version.py --check; then
    echo
    echo "pre-commit: package version is inconsistent. Fix it, stage, and commit again."
    exit 1
fi

# GitHub detects the licence only at the root; the package ships its own copy. Both are real
# files rather than a symlink: git stores a symlink as its target path, which Windows checkouts
# leave as a plain text file and GitHub's licence detection would likely not follow.
if ! cmp -s LICENSE Packages/com.entropyreductionservices.singleton/LICENSE; then
    echo
    echo "pre-commit: LICENSE and the package's LICENSE differ. Make them identical and commit again."
    exit 1
fi

<Project Sdk="Microsoft.NET.Sdk">

  <!-- Generated from package.json by scripts/sync-version.py. -->
  <Import Project="../Version.props" />

  <!--
    Unit tests for the analyzer rules, run by `dotnet test` and by CI.

    These exist because the analyzer can fail completely without failing anything else: it
    resolves its base type by metadata name at compilation start and registers no actions when
    that lookup misses, so a wrong string disables every rule while every build stays green.
    That shipped once. Every test here therefore asserts a rule actually fires, not merely that
    the analyzer loads.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!--
      Targets net8.0 to match the SDK CI installs, but rolls forward so the same test project
      also runs on a machine that only has a newer runtime installed.
    -->
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />

    <!--
      The unsuffixed testing package with DefaultVerifier; the framework-suffixed variants
      (…Testing.NUnit) are deprecated and pin Roslyn 1.0.1.

      Microsoft.CodeAnalysis.CSharp must be referenced explicitly and must be at least the
      version the analyzer itself compiles against, or the test project resolves the testing
      package's much older transitive copy and the reference to the analyzer fails to load
      with CS1705.
    -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" Version="1.1.4" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../ERS.Singleton.Analyzers.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Embedded as text, not compiled: the harness prepends it to every snippet as source. Shared
      with StalenessProbe so the probe cannot model a smaller hierarchy than the tests.
    -->
    <EmbeddedResource Include="../Shared/SingletonStubs.cs" LogicalName="SingletonStubs.cs" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Handed to CommittedAnalyzerVersionTests so it can check the committed DLL without guessing
      at a relative path from the test binary's output folder.
    -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ExpectedAnalyzerVersion</_Parameter1>
      <_Parameter2>$(Version)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>CommittedAnalyzerPath</_Parameter1>
      <_Parameter2>$(MSBuildThisFileDirectory)../../Runtime/Analyzers/ERS.Singleton.Analyzers.dll</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
